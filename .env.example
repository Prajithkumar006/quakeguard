# QuakeGuard Environment Configuration
PORT=8080
NODE_ENV=development

# USGS Seismic Data Feed URL
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.geojson

# Mapbox / OpenStreetMap Tile Server
MAP_TILE_SERVER=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# Emergency Hotline & Dispatch Configuration
EMERGENCY_DISPATCH_HOTLINE=911
SMS_GATEWAY_API_KEY=your_sms_gateway_key_here

# AI server (ai_server/). Optional: lets the assistant answer open-ended earthquake-safety questions.
# Keep this on the server only - never put it in front-end code.
ANTHROPIC_API_KEY=
QG_MODEL=claude-sonnet-5-5
# Comma-separated origins allowed to call the AI server (default: any, fine for local use only)
QG_ALLOWED_ORIGINS=*
